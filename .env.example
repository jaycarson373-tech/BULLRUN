NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DISPLAY_TIME_ZONE=America/Toronto
NEXT_PUBLIC_BULLRUN_CA=
NEXT_PUBLIC_BULLRUN_X_URL=
NEXT_PUBLIC_PUMP_FUN_URL=
NEXT_PUBLIC_DEXSCREENER_URL=
NEXT_PUBLIC_BUY_BULLRUN_URL=
NEXT_PUBLIC_COINGECKO_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel/API. In local development, "dev-admin" is accepted when this is empty.
ADMIN_API_KEY=

# Race + worker
SEASON_START_ISO=
RACE_DURATION_MINUTES=90
WORKER_MODE=cron
WORKER_POLL_MS=30000
API_ENABLE_AUTO_TICK=true
DEFAULT_CREATOR_FEE_SOL=2
TEST_MODE=false
BULLRUN_MINT=
BULLRUN_MIN_HOLDING=100000

# Optional external market-cap provider.
# Helius can price by token mint when getAsset returns token_info.price_info.
HELIUS_API_KEY=
HELIUS_RPC_URL=
TOKEN_FIXED_SUPPLY=1000000000

# Optional custom provider. Expected response:
# {"data":{"<tokenMint>":{"marketCap":123456}}}
# or {"data":{"<tokenMint>":{"price":0.000123}}}
MARKET_CAP_API_URL=
MARKET_CAP_API_KEY=
