NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel/API. In local development, "dev-admin" is accepted when this is empty.
ADMIN_API_KEY=

# Race + worker
SEASON_START_ISO=
WORKER_MODE=cron
WORKER_POLL_MS=30000
API_ENABLE_AUTO_TICK=true
DEFAULT_CREATOR_FEE_SOL=2

# Optional external market-cap provider.
# Expected response: {"data":{"<tokenMint>":{"marketCap":123456}}}
MARKET_CAP_API_URL=
MARKET_CAP_API_KEY=
